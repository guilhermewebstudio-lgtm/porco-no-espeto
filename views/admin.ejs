<!DOCTYPE html>
<html lang="pt-PT">
<head>
<%- include('partials/head') %>
  <title>Pedidos | <%= site.nome %></title>
</head>
<body>
  <%- include('partials/topo', { ativa: 'pedidos' }) %>

  <main>
    <h1>Pedidos de orçamento</h1>

    <% if (!temDb) { %>
      <p class="sub">Base de dados não configurada</p>
      <p class="aviso">Falta definir a <code>DATABASE_URL</code> no Render. Sem ela não há lista de pedidos, nem chat, nem calendário.</p>
    <% } else { %>
      <p class="sub"><%= contagens.todos %> <%= contagens.todos === 1 ? 'pedido' : 'pedidos' %> no total. Os que precisam de resposta aparecem a laranja.</p>

      <nav class="filtros">
        <a href="/admin" class="<%= !filtro ? 'on' : '' %>">Todos<span><%= contagens.todos %></span></a>
        <% Object.keys(ESTADOS).forEach(function(k){ %>
          <a href="/admin?estado=<%= k %>" class="<%= filtro === k ? 'on' : '' %>"><%= ESTADOS[k] %><span><%= contagens[k] %></span></a>
        <% }) %>
      </nav>

      <% if (!pedidos.length) { %>
        <p class="aviso">Não há pedidos <%= filtro ? 'neste estado' : 'ainda' %>. Quando alguém preencher o formulário do site, aparece aqui.</p>
      <% } else { %>
        <div class="lista">
          <% pedidos.forEach(function(p){ %>
          <a class="item <%= p.atencao ? 'atencao' : '' %>" href="/admin/pedido/<%= p.id %>">
            <div class="cab">
              <h3><%= p.nome %><% if (p.nao_lidas > 0) { %><span class="bola"><%= p.nao_lidas %></span><% } %></h3>
              <div class="tags">
                <span class="tipo"><%= p.tipo || 'Evento' %></span>
                <span class="estado <%= p.estado %>"><%= ESTADOS[p.estado] || p.estado %></span>
              </div>
            </div>
            <p class="quando">Recebido em <%= new Date(p.criado_em).toLocaleString('pt-PT', { timeZone: 'Europe/Lisbon', dateStyle: 'long', timeStyle: 'short' }) %></p>
            <div class="dados">
              <span><b>Contacto</b><%= p.contacto %></span>
              <% if (p.data_evento) { %><span><b>Data</b><%= p.data_evento %></span><% } %>
              <% if (p.convidados) { %><span><b>Convidados</b><%= p.convidados %></span><% } %>
              <% if (p.localidade) { %><span><b>Local</b><%= p.localidade %></span><% } %>
            </div>
          </a>
          <% }) %>
        </div>
      <% } %>
    <% } %>
  </main>

  <script>
    // Atualiza a lista de vez em quando para apanhar mensagens novas
    setInterval(function () { if (!document.hidden) location.reload(); }, 45000);
  </script>
</body>
</html>
