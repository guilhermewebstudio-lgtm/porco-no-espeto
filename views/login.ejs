<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Área reservada | <%= site.nome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
  <main class="box">
    <img class="chama" src="/img/logo.jpg" alt="" width="96" height="96">
    <h1>Porco no Espeto</h1>
    <p class="sub">Área reservada</p>
    <p class="desc">Entra para ver os pedidos de orçamento.</p>

    <form method="post" action="/admin/login" autocomplete="off">
      <div>
        <label for="password">Palavra-passe</label>
        <div class="campo">
          <input id="password" name="password" type="password" class="com-ver" required autofocus autocomplete="current-password">
          <button type="button" class="ver" data-alvo="password" aria-label="Mostrar palavra-passe">Mostrar</button>
        </div>
      </div>
      <% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
      <button type="submit" class="btn">Entrar</button>
    </form>

    <a class="voltar" href="/">← Voltar ao site</a>
  </main>

  <script src="/js/auth.js"></script>
</body>
</html>
