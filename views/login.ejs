<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Área reservada | <%= site.nome %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,900&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px;
      font-family: 'Manrope', system-ui, sans-serif; color: #f6ecdc;
      background:
        radial-gradient(800px 480px at 85% 10%, rgba(232, 87, 31, .32), transparent 60%),
        radial-gradient(700px 480px at 5% 95%, rgba(184, 121, 58, .28), transparent 60%),
        linear-gradient(180deg, #17110d, #2a1a10);
    }
    .box {
      width: min(400px, 100%); background: rgba(34, 24, 18, .92);
      border: 1px solid rgba(255, 255, 255, .08); border-radius: 22px;
      padding: 38px 32px 30px; box-shadow: 0 24px 60px rgba(0, 0, 0, .45);
      animation: subir .6s ease both; text-align: center;
    }
    @keyframes subir { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    .chama { font-size: 2.6rem; line-height: 1; }
    h1 { font-family: 'Fraunces', Georgia, serif; font-weight: 900; font-size: 1.8rem; margin: 12px 0 2px; }
    .sub { color: #ff7a3d; text-transform: uppercase; letter-spacing: .18em; font-size: .7rem; font-weight: 700; margin: 0 0 6px; }
    .desc { color: #bba68a; font-size: .92rem; margin: 14px 0 24px; }
    form { display: grid; gap: 14px; text-align: left; }
    label { font-weight: 700; font-size: .82rem; }
    .campo { position: relative; margin-top: 6px; }
    input {
      width: 100%; font: inherit; color: #f6ecdc; background: #17110d;
      border: 1.5px solid #4a3626; border-radius: 12px; padding: 14px 70px 14px 16px;
    }
    input:focus { outline: none; border-color: #e8571f; box-shadow: 0 0 0 3px rgba(232, 87, 31, .22); }
    .ver {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      appearance: none; background: transparent; border: 0; cursor: pointer;
      color: #bba68a; font: 600 .8rem 'Manrope', sans-serif; padding: 8px 10px; border-radius: 8px;
    }
    .ver:hover { color: #ff7a3d; }
    .erro {
      background: rgba(179, 38, 30, .18); border: 1px solid rgba(255, 120, 110, .35);
      color: #ffb4ab; border-radius: 10px; padding: 10px 14px; font-size: .88rem; font-weight: 600; margin: 0;
    }
    .btn {
      appearance: none; border: 0; cursor: pointer; font: 700 1rem 'Manrope', sans-serif; color: #fff;
      background: linear-gradient(135deg, #e8571f, #ff7a3d); border-radius: 999px; padding: 14px;
      box-shadow: 0 8px 22px rgba(232, 87, 31, .35); transition: transform .2s, box-shadow .2s;
    }
    .btn:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(232, 87, 31, .45); }
    .voltar { display: inline-block; margin-top: 22px; color: #a89580; font-size: .85rem; text-decoration: none; }
    .voltar:hover { color: #ff7a3d; }
    @media (prefers-reduced-motion: reduce) { .box { animation: none; } }
  </style>
</head>
<body>
  <main class="box">
    <div class="chama">🔥</div>
    <h1>Porco no Espeto</h1>
    <p class="sub">Área reservada</p>
    <p class="desc">Entra para ver os pedidos de orçamento.</p>

    <form method="post" action="/admin/login" autocomplete="off">
      <div>
        <label for="password">Palavra-passe</label>
        <div class="campo">
          <input id="password" name="password" type="password" required autofocus autocomplete="current-password">
          <button type="button" class="ver" id="ver" aria-label="Mostrar palavra-passe">Mostrar</button>
        </div>
      </div>
      <% if (erro) { %><p class="erro" role="alert"><%= erro %></p><% } %>
      <button type="submit" class="btn">Entrar</button>
    </form>

    <a class="voltar" href="/">← Voltar ao site</a>
  </main>

  <script>
    (function () {
      var i = document.getElementById('password');
      var b = document.getElementById('ver');
      b.addEventListener('click', function () {
        var mostrar = i.type === 'password';
        i.type = mostrar ? 'text' : 'password';
        b.textContent = mostrar ? 'Esconder' : 'Mostrar';
        b.setAttribute('aria-label', mostrar ? 'Esconder palavra-passe' : 'Mostrar palavra-passe');
        i.focus();
      });
    })();
  </script>
</body>
</html>
